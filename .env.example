# ==========================================
# AttendX — Production Environment Configuration
# ==========================================

# ── Application Info ──
PROJECT_NAME="AttendX"

# ── Security & Authentication ──
# IMPORTANT: Generate a random 64-char secret key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY="attendx_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days

# ── Database ──
# Default SQLite (stored inside persistent storage volume in Docker):
DATABASE_URL="sqlite:////app/storage/attendx.db"
# Or PostgreSQL for cloud/enterprise deployments:
# DATABASE_URL="postgresql://attendx_user:your_password@localhost:5432/attendx_db"

# ── CORS Settings ──
# Comma-separated allowed frontend domains (or "*" to allow all during development)
CORS_ORIGINS="*"
# CORS_ORIGINS="https://yourdomain.com,https://attendx.vercel.app"

# ── Storage & File Exports ──
STORAGE_DIR="./storage"
EXPORTS_DIR="./exports"

# ── Frontend Environment (When deploying separately) ──
# VITE_API_URL="https://api.yourdomain.com"

# ── Face Recognition & Quality Thresholds (SFace Metric) ──
FACE_MATCH_THRESHOLD=0.45       # Match score required for automatic PRESENT
FACE_REVIEW_THRESHOLD=0.35      # Match score required for NEEDS_REVIEW (below is UNKNOWN)
FACE_MIN_MARGIN=0.08            # Minimum gap between Top-1 and Top-2 candidate
FACE_MIN_SIZE=24                # Minimum face box width/height in pixels
FACE_BLUR_THRESHOLD=45.0        # Minimum Laplacian sharpness variance
FACE_DETECTION_THRESHOLD=0.45   # Face detector sensitivity
