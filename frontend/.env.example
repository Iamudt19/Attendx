# Base API URL (Leave empty or '/' if served behind Nginx reverse-proxy on same host/port)
# Set to full backend URL if frontend is deployed on a separate domain (e.g., Vercel, Netlify, Cloudflare Pages)
VITE_API_URL=
# Example for separate deployment:
# VITE_API_URL=https://attendx-api.onrender.com

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
